{
  "name": "ctrlpass",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile:android": "npm run android --workspace=apps/mobile",
    "mobile:start": "npm run start --workspace=apps/mobile",
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "typecheck:web": "npm run typecheck --workspace=apps/web",
    "typecheck:mobile": "npm run typecheck --workspace=apps/mobile",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile"
  }
}
