# CtrlPass Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Clerk Authentication (https://dashboard.clerk.com → API Keys)
# Publishable key — safe for the browser (pk_test_… / pk_live_…)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key — SERVER-SIDE ONLY, never expose to the client (sk_test_… / sk_live_…)
CLERK_SECRET_KEY=

# Cashfree Sandbox / Production Credentials (Server-side Edge / API only)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=TEST
